   "source": [
    "Plot1 <- college %>%\n",
    "  group_by(region) %>%\n",
    "  summarize(average_tuition=mean(tuition)) %>%\n",
    "  ggplot() +\n",
    "  geom_col(mapping=aes(x=region, y=average_tuition, fill=region)) +\n",
    "  theme(plot.background=element_rect(fill='grey99')) +\n",
    "  theme(panel.background=element_rect(fill='palegoldenrod'))\n",
    "print(Plot1)"
   ]
  },
